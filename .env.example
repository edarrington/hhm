# Environment Configuration Template

# Azure OpenAI Configuration
VOICE_ENDPOINT=https://[region].api.cognitive.microsoft.com
VOICE_API_KEY=[your-azure-openai-key]
VOICE_MODEL=gpt-4-realtime  # or gpt-4o-realtime
VOICE_DEPLOYMENT=realtime-gpt-4

# Google OAuth Configuration
GOOGLE_CLIENT_ID=[your-google-oauth-client-id]
GOOGLE_CLIENT_SECRET=[your-google-oauth-client-secret]
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Todoist Configuration
TODOIST_API_TOKEN=[your-todoist-api-token]

# Memory Service Configuration
MEMORY_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hhm_db
DATABASE_POOL_SIZE=20

# Authentication
HOUSEHOLD_SECRET_KEY=[generate-with: openssl rand -hex 32]
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Feature Flags
ENABLE_VOICE=true
ENABLE_MEMORY=true
ENABLE_CALENDAR=true
ENABLE_GMAIL=true
ENABLE_DRIVE=true
ENABLE_TODOIST=true
ENABLE_CONVERSATION_LOGGING=true

# Development
DEBUG=false
MOCK_MODE=false
ENVIRONMENT=development  # development, staging, production

# Optional: Arcade.dev for OAuth management
ARCADE_API_KEY=[optional-if-using-arcade]

# Observability
SENTRY_DSN=
OPENTELEMETRY_ENABLED=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
